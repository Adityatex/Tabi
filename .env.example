# Copy this to .env (gitignored; never commit real keys).
# Used only by the eval harness (npm run eval). The extension itself takes
# keys in its Settings, not from here.
#
# Set the one(s) for the provider you benchmark with --provider:
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=
OPENCODE_API_KEY=
# Fallback for any provider, including --provider custom:
LLM_API_KEY=
